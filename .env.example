# Copy to .env (never commit .env). Every value is optional: with no env the app runs in demo mode.

# --- Server ---
PORT=8910
# demo = simulated deposit/swap/payout (safe). live = real 1Click quotes with real deposit addresses (MAINNET FUNDS).
SIKASEND_MODE=demo

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional JWT from the NEAR Intents partner portal. Quotes work without it. Check the 1Click docs
# for the fee/rate-limit terms that apply to unauthenticated vs authenticated use before going live.
ONECLICK_JWT=

# --- NEAR ---
NEAR_RPC_URL=https://free.rpc.fastnear.com
# Your treasury account. Generate a fresh one with `npm run treasury:keygen`, or use your own wallet.
# Unset = a placeholder implicit account whose key nobody holds (demo only, do not send funds to it).
NEAR_TREASURY_ACCOUNT=
NEAR_USDC_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# --- Pricing (what the sender sees) ---
PLATFORM_FEE_BPS=50
FX_SPREAD_BPS=100
BENCHMARK_COST_PCT=8.46

# --- Agent guardrails ---
LIMIT_PER_TRANSFER_USD=1000
LIMIT_DAILY_USD=2000
LIMIT_MONTHLY_USD=6000

# --- Demo behaviour ---
# 1 = a transfer completes in ~13s. 0.5 = twice as fast, 2 = twice as slow.
DEMO_SPEED=1
# "off" disables the scripted first-attempt MoMo timeout (the visible retry).
DEMO_CHAOS=on

# --- Optional LLM for the agent parser (any OpenAI-compatible /chat/completions) ---
# Without these the deterministic rule parser is used. The LLM only extracts fields; it cannot
# send money or change limits, and its output is validated against the contact whitelist.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Hosted (Vercel) demo only: HMAC key (32+ random chars) for the signed, client-held demo session.
# Lets any serverless instance serve any visitor without a shared store. Unset = in-memory state (fine for one process).
SIKASEND_SESSION_SECRET=
